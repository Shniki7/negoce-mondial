rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Seuls les joueurs connectés (connexion anonyme du jeu) peuvent lire et écrire.
    // Un document de partie est limité à 300 Ko pour éviter les abus.
    match /games/{gameId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.resource.data._j is string && request.resource.data._j.size() < 300000;
      allow delete: if request.auth != null;
    }
    match /rulesets/{rulesId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.resource.data._j is string && request.resource.data._j.size() < 300000;
      allow delete: if request.auth != null;
    }
    // Tout le reste est fermé.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
